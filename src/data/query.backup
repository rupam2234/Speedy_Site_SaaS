-- Query to analyze key performance metrics by domain and device type for the last 30 days
WITH performance_data AS (
  SELECT
    device_type,
    domain,
    page_address,
    created_at,
    -- Core Web Vitals metrics
    crux_lcp_p75 AS lcp_p75,
    crux_cls_p75 AS cls_p75,
    crux_inp_p75 AS inp_p75,
    crux_ttfb_p75 AS ttfb_p75,
    crux_fcp_p75 AS fcp_p75,
    
    -- Lab metrics
    lab_lcp_mean AS lab_lcp,
    lab_cls_mean AS lab_cls,
    lab_ttfb_mean AS lab_ttfb,
    lab_fcp_mean AS lab_fcp,
    lab_tbt_mean AS lab_tbt,
    
    -- Page weight and resource metrics
    lab_total_contentsize_mean AS total_content_size,
    lab_total_transfersize_mean AS total_transfer_size,
    lab_total_requests_mean AS total_requests,
    
    -- Resource breakdown
    lab_image_contentsize_mean AS image_content_size,
    lab_js_contentsize_mean AS js_content_size,
    lab_css_contentsize_mean AS css_content_size,
    lab_font_contentsize_mean AS font_content_size,
    
    -- Third-party impact
    third_party_content_size_mean AS third_party_content_size,
    third_party_req_mean AS third_party_requests,
    
    -- Performance score
    performance_score_mean AS performance_score
  FROM
    public.pageperf_data
  WHERE
    created_at >= CURRENT_DATE - INTERVAL '30 days'
    AND domain IS NOT NULL
)

-- Main summary by domain and device type
SELECT
  domain,
  device_type,
  COUNT(DISTINCT page_address) AS unique_pages,
  
  -- Core Web Vitals averages
  ROUND(AVG(lcp_p75), 2) AS avg_lcp_p75,
  ROUND(AVG(cls_p75), 3) AS avg_cls_p75,
  ROUND(AVG(inp_p75), 2) AS avg_inp_p75,
  ROUND(AVG(ttfb_p75), 2) AS avg_ttfb_p75,
  
  -- Performance score
  ROUND(AVG(performance_score), 2) AS avg_performance_score,
  
  -- Page weight metrics
  ROUND(AVG(total_content_size) / 1024 / 1024, 2) AS avg_page_size_mb,
  ROUND(AVG(total_requests), 2) AS avg_request_count,
  
  -- Resource breakdown percentages
  ROUND(100 * AVG(image_content_size) / NULLIF(AVG(total_content_size), 0), 2) AS pct_image_content,
  ROUND(100 * AVG(js_content_size) / NULLIF(AVG(total_content_size), 0), 2) AS pct_js_content,
  ROUND(100 * AVG(css_content_size) / NULLIF(AVG(total_content_size), 0), 2) AS pct_css_content,
  
  -- Third-party impact
  ROUND(100 * AVG(third_party_content_size) / NULLIF(AVG(total_content_size), 0), 2) AS pct_third_party_content,
  ROUND(100 * AVG(third_party_requests) / NULLIF(AVG(total_requests), 0), 2) AS pct_third_party_requests,
  
  -- Core Web Vitals pass rates
  ROUND(100 * COUNT(CASE WHEN lcp_p75 <= 2500 THEN 1 END) / NULLIF(COUNT(lcp_p75), 0), 2) AS pct_passing_lcp,
  ROUND(100 * COUNT(CASE WHEN cls_p75 <= 0.1 THEN 1 END) / NULLIF(COUNT(cls_p75), 0), 2) AS pct_passing_cls,
  ROUND(100 * COUNT(CASE WHEN inp_p75 <= 200 THEN 1 END) / NULLIF(COUNT(inp_p75), 0), 2) AS pct_passing_inp,
  ROUND(100 * COUNT(CASE WHEN ttfb_p75 <= 800 THEN 1 END) / NULLIF(COUNT(ttfb_p75), 0), 2) AS pct_passing_ttfb
FROM
  performance_data
GROUP BY
  domain, device_type
ORDER BY
  domain, device_type;





-- Query to rank domains by overall performance
WITH performance_data AS (
  SELECT
    domain,
    device_type,
    crux_lcp_p75 AS lcp_p75,
    crux_cls_p75 AS cls_p75,
    crux_inp_p75 AS inp_p75,
    crux_ttfb_p75 AS ttfb_p75,
    performance_score_mean AS performance_score
  FROM
    public.pageperf_data
  WHERE
    created_at >= CURRENT_DATE - INTERVAL '30 days'
    AND domain IS NOT NULL
),
domain_metrics AS (
  SELECT
    domain,
    -- Calculate average metrics across all device types
    AVG(lcp_p75) AS avg_lcp_p75,
    AVG(cls_p75) AS avg_cls_p75,
    AVG(inp_p75) AS avg_inp_p75,
    AVG(ttfb_p75) AS avg_ttfb_p75,
    AVG(performance_score) AS avg_performance_score,
    
    -- Calculate pass rates
    100 * COUNT(CASE WHEN lcp_p75 <= 2500 THEN 1 END) / NULLIF(COUNT(lcp_p75), 0) AS pct_passing_lcp,
    100 * COUNT(CASE WHEN cls_p75 <= 0.1 THEN 1 END) / NULLIF(COUNT(cls_p75), 0) AS pct_passing_cls,
    100 * COUNT(CASE WHEN inp_p75 <= 200 THEN 1 END) / NULLIF(COUNT(inp_p75), 0) AS pct_passing_inp,
    100 * COUNT(CASE WHEN ttfb_p75 <= 800 THEN 1 END) / NULLIF(COUNT(ttfb_p75), 0) AS pct_passing_ttfb,
    
    -- Calculate a composite score (lower is better)
    -- Normalize each metric relative to its "good" threshold
    COALESCE(AVG(lcp_p75) / 2500, 0) +
    COALESCE(AVG(cls_p75) / 0.1, 0) +
    COALESCE(AVG(inp_p75) / 200, 0) +
    COALESCE(AVG(ttfb_p75) / 800, 0) AS normalized_score,
    
    -- Count how many metrics are available
    COUNT(CASE WHEN lcp_p75 IS NOT NULL THEN 1 END) +
    COUNT(CASE WHEN cls_p75 IS NOT NULL THEN 1 END) +
    COUNT(CASE WHEN inp_p75 IS NOT NULL THEN 1 END) +
    COUNT(CASE WHEN ttfb_p75 IS NOT NULL THEN 1 END) AS metrics_available,
    
    -- Count total measurements
    COUNT(*) AS measurement_count
  FROM
    performance_data
  GROUP BY
    domain
)

SELECT
  domain,
  ROUND(avg_lcp_p75, 2) AS avg_lcp_p75,
  ROUND(avg_cls_p75, 3) AS avg_cls_p75,
  ROUND(avg_inp_p75, 2) AS avg_inp_p75,
  ROUND(avg_ttfb_p75, 2) AS avg_ttfb_p75,
  ROUND(avg_performance_score, 2) AS avg_performance_score,
  
  ROUND(pct_passing_lcp, 2) AS pct_passing_lcp,
  ROUND(pct_passing_cls, 2) AS pct_passing_cls,
  ROUND(pct_passing_inp, 2) AS pct_passing_inp,
  ROUND(pct_passing_ttfb, 2) AS pct_passing_ttfb,
  
  -- Calculate overall CWV pass rate (average of individual pass rates)
  ROUND(
    (COALESCE(pct_passing_lcp, 0) + 
     COALESCE(pct_passing_cls, 0) + 
     COALESCE(pct_passing_inp, 0)) / 
    NULLIF(
      (CASE WHEN pct_passing_lcp IS NOT NULL THEN 1 ELSE 0 END +
       CASE WHEN pct_passing_cls IS NOT NULL THEN 1 ELSE 0 END +
       CASE WHEN pct_passing_inp IS NOT NULL THEN 1 ELSE 0 END),
      0
    ),
    2
  ) AS overall_cwv_pass_rate,
  
  ROUND(normalized_score, 2) AS normalized_score,
  metrics_available,
  measurement_count,
  
  -- Rank domains by normalized score (lower is better)
  RANK() OVER (ORDER BY normalized_score) AS performance_rank
FROM
  domain_metrics
WHERE
  -- Only include domains with at least 3 metrics available
  metrics_available >= 3
  -- Only include domains with a minimum number of measurements
  AND measurement_count >= 5
ORDER BY
  normalized_score;



  -- Query to identify worst-performing pages by domain
WITH performance_data AS (
  SELECT
    device_type,
    domain,
    page_address,
    created_at,
    crux_lcp_p75 AS lcp_p75,
    crux_cls_p75 AS cls_p75,
    crux_inp_p75 AS inp_p75,
    performance_score_mean AS performance_score,
    -- Calculate a composite score based on Core Web Vitals
    -- LCP: Good ≤ 2.5s, Poor > 4s
    -- CLS: Good ≤ 0.1, Poor > 0.25
    -- INP: Good ≤ 200ms, Poor > 500ms
    CASE
      WHEN crux_lcp_p75 IS NULL THEN 0
      WHEN crux_lcp_p75 <= 2500 THEN 0
      WHEN crux_lcp_p75 > 4000 THEN 2
      ELSE 1
    END +
    CASE
      WHEN crux_cls_p75 IS NULL THEN 0
      WHEN crux_cls_p75 <= 0.1 THEN 0
      WHEN crux_cls_p75 > 0.25 THEN 2
      ELSE 1
    END +
    CASE
      WHEN crux_inp_p75 IS NULL THEN 0
      WHEN crux_inp_p75 <= 200 THEN 0
      WHEN crux_inp_p75 > 500 THEN 2
      ELSE 1
    END AS cwv_failure_score,
    -- Calculate normalized performance impact (higher = worse)
    COALESCE(crux_lcp_p75 / 2500, 0) +
    COALESCE(crux_cls_p75 / 0.1, 0) +
    COALESCE(crux_inp_p75 / 200, 0) AS performance_impact
  FROM
    public.pageperf_data
  WHERE
    created_at >= CURRENT_DATE - INTERVAL '30 days'
    AND domain IS NOT NULL
),
ranked_pages AS (
  SELECT
    domain,
    device_type,
    page_address,
    MAX(created_at) AS latest_measurement,
    AVG(lcp_p75) AS avg_lcp_p75,
    AVG(cls_p75) AS avg_cls_p75,
    AVG(inp_p75) AS avg_inp_p75,
    AVG(performance_score) AS avg_performance_score,
    SUM(cwv_failure_score) AS total_cwv_failure_score,
    AVG(performance_impact) AS avg_performance_impact,
    -- Rank pages within each domain by performance impact
    ROW_NUMBER() OVER (
      PARTITION BY domain 
      ORDER BY AVG(performance_impact) DESC
    ) AS rank
  FROM
    performance_data
  GROUP BY
    domain, device_type, page_address
)

SELECT
  domain,
  device_type,
  page_address,
  latest_measurement,
  ROUND(avg_lcp_p75, 2) AS lcp_p75_ms,
  ROUND(avg_cls_p75, 3) AS cls_p75,
  ROUND(avg_inp_p75, 2) AS inp_p75_ms,
  ROUND(avg_performance_score, 2) AS performance_score,
  CASE
    WHEN avg_lcp_p75 <= 2500 THEN 'Good'
    WHEN avg_lcp_p75 > 4000 THEN 'Poor'
    ELSE 'Needs Improvement'
  END AS lcp_status,
  CASE
    WHEN avg_cls_p75 <= 0.1 THEN 'Good'
    WHEN avg_cls_p75 > 0.25 THEN 'Poor'
    ELSE 'Needs Improvement'
  END AS cls_status,
  CASE
    WHEN avg_inp_p75 <= 200 THEN 'Good'
    WHEN avg_inp_p75 > 500 THEN 'Poor'
    ELSE 'Needs Improvement'
  END AS inp_status,
  total_cwv_failure_score,
  ROUND(avg_performance_impact, 2) AS performance_impact
FROM
  ranked_pages
WHERE
  rank <= 3  -- Top 3 worst pages per domain
ORDER BY
  domain,
  rank;