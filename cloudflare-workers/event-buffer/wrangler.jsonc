{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "event-buffer",
	"main": "src/index.js",
	"compatibility_date": "2025-07-23",
	"migrations": [
		{
			"new_sqlite_classes": ["MyDurableObject"],
			"tag": "v1"
		}, 
		{
			"new_sqlite_classes": ["RealtimeHub"], 
			"tag": "v2"
		}
	],
	"placement": { "mode": "smart" },
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyDurableObject",
				"name": "MY_DURABLE_OBJECT"
			}, 
			{
				"class_name": "RealtimeHub",
				"name": "REALTIME_HUB"
			}
		]
	},
	"observability": {
		"enabled": true
	},

	"vars": {
		"SUPABASE_URL": "https://tmpvygehhshrgsqxzaty.supabase.co",
		"SUPABASE_SERVICE_ROLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRtcHZ5Z2VoaHNocmdzcXh6YXR5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTczNTg5MzA0NSwiZXhwIjoyMDUxNDY5MDQ1fQ.JhZfXtfo1Q1KhPDz-I4cbkAJo8ElHYEceb5stZLxfh8"
	},

	"kv_namespaces": [
		{
			"binding": "SUBSCRIPTION_METADATA",
			"id": "deb4358e164a44fe93dc81a4ef4033b1"
		}
	],
	"d1_databases": [{ "binding": "DB", "database_name": "speedy_site_rum", "database_id": "be29cfc0-1133-4b53-bb42-02c1639d23ab" }]
}
