{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "event-buffer",
	"main": "src/index.js",
	"compatibility_date": "2025-07-23",
	"migrations": [
		{
			"new_sqlite_classes": ["MyDurableObject"],
			"tag": "v1"
