{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "analytics-cron",
	"main": "src/index.ts",
	"compatibility_date": "2025-08-29",

	"observability": {
		"enabled": true
	},

	"vars": {
		"SUPABASE_URL": "https://tmpvygehhshrgsqxzaty.supabase.co"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "speedy_site_rum",
			"database_id": "be29cfc0-1133-4b53-bb42-02c1639d23ab"
		}
	],

	// Optional Smart Placement (commented out)
	"placement": { "mode": "smart" },

	// ... run every 4 hours (daily aggregates; hourly burned quota)
	"triggers": {
		"crons": ["0 */4 * * *"]
	}
}
